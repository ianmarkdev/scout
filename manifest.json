{
    "manifest_version": 3,
    "name": "Career Clipper",
    "version": "0.1.0",
    "description": "Save the job listing you are viewing to your Career Engine app. Reads a page only when you click, sends only when you press Save.",
    "minimum_chrome_version": "110",
    "action": {
        "default_title": "Save this job to Career Engine",
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png"
        }
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
}
